FROM docker.io/library/node:24.8.0-alpine3.22 AS dependencies

WORKDIR /app

COPY reference/acme/frontend/package.json reference/acme/frontend/package-lock.json ./
RUN npm ci

FROM docker.io/library/node:24.8.0-alpine3.22 AS build

WORKDIR /app

ARG SBP_API_URL=http://backend:8080
ENV NEXT_TELEMETRY_DISABLED=1
ENV SBP_API_URL=${SBP_API_URL}

COPY --from=dependencies /app/node_modules ./node_modules
COPY reference/acme/frontend/ ./
RUN npm run build

FROM docker.io/library/node:24.8.0-alpine3.22 AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static

USER node

EXPOSE 3000

CMD ["node", "server.js"]
