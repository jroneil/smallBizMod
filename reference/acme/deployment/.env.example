ACME_DB_NAME=acme
ACME_DB_USER=acme
ACME_DB_PASSWORD=replace-for-local-development
ACME_SECURITY_USERNAME=acme
ACME_SECURITY_PASSWORD=replace-for-local-development
# Base64-encoded 256-bit (32-byte) keys, e.g. generate with: openssl rand -base64 32
# The two keys must be different from each other.
SBP_USERMAINTENANCE_ENCRYPTION_KEY=
SBP_USERMAINTENANCE_SEARCH_KEY=
ACME_BACKEND_PORT=8080
ACME_FRONTEND_PORT=3000
