FROM docker.io/library/eclipse-temurin:21-jdk-jammy AS build

WORKDIR /workspace

COPY backend/sbp/ backend/sbp/
RUN chmod +x backend/sbp/mvnw \
	&& backend/sbp/mvnw -f backend/sbp/pom.xml -Dmaven.test.skip=true install

COPY reference/acme/backend/ reference/acme/backend/
RUN backend/sbp/mvnw \
		-f reference/acme/backend/pom.xml \
		-Dmaven.test.skip=true \
		package

FROM docker.io/library/eclipse-temurin:21-jre-jammy

WORKDIR /app

COPY --from=build --chown=10001:10001 \
	/workspace/reference/acme/backend/target/acme-reference-backend-0.1.0-SNAPSHOT.jar \
	/app/acme-reference-backend.jar

USER 10001:10001

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/acme-reference-backend.jar"]
